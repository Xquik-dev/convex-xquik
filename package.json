{
  "name": "xquik-convex",
  "version": "0.2.0",
  "description": "Convex component for X (Twitter) data & actions through Xquik, with signed webhooks & live queries. Not affiliated with X Corp.",
  "license": "Apache-2.0",
  "author": {
    "name": "Xquik",
    "email": "support@xquik.com",
    "url": "https://xquik.com"
  },
  "homepage": "https://docs.xquik.com/guides/convex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xquik-dev/xquik-convex.git"
  },
  "bugs": {
    "url": "https://github.com/Xquik-dev/xquik-convex/issues"
  },
  "keywords": [
    "convex",
    "convex-component",
    "component",
    "twitter",
    "twitter-api",
    "x-api",
    "twitter-scraper",
    "tweets",
    "webhooks",
    "xquik"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "imports": {
    "#.prettierrc.json": "./.prettierrc.json",
    "#example/*": "./example/*",
    "#openapi.json": "./openapi.json",
    "#scripts/*": "./scripts/*",
    "#src/*": "./src/*"
  },
  "types": "./dist/client.d.ts",
  "module": "./dist/client.js",
  "scripts": {
    "generate": "node --input-type=module --eval \"import { registryJson } from './scripts/registry.ts'; process.stdout.write(await registryJson());\" >src/component/registry.json && node --input-type=module --eval \"import { operationsModule } from './scripts/registry.ts'; process.stdout.write(operationsModule());\" >src/component/operations.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 $(git ls-files --cached --others --exclude-standard '*.ts' '*.js')",
    "type-coverage": "type-coverage --project tsconfig.json --strict --at-least 100 --detail -- $(git ls-files --cached --others --exclude-standard '*.ts' '*.js')",
    "test": "vitest run --coverage $(git ls-files --cached --others --exclude-standard 'src/*.ts' 'scripts/*.ts' 'example/*.ts' | sed 's/^/--coverage.include=/')",
    "mutation": "stryker run --mutate \"$(git ls-files --cached --others --exclude-standard 'src/*.ts' 'scripts/*.ts' 'example/*.ts' | paste -sd , -)\"",
    "prepack": "convex codegen --component-dir ./src/component && rm -rf dist && tsc --project tsconfig.build.json && convex codegen",
    "bundle": "rm -rf dist && tsc --project tsconfig.build.json",
    "publint": "publint --strict --level suggestion",
    "attw": "attw --profile esm-only"
  },
  "peerDependencies": {
    "convex": "^1.48.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@convex-dev/eslint-plugin": "5.0.0",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "convex": "1.48.0",
    "convex-test": "0.0.66",
    "eslint": "10.13.0",
    "fallow": "3.37.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "type-coverage": "2.30.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "qs": "6.17.0"
  }
}
